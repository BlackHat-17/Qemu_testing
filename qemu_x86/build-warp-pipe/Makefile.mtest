
SPEED = quick

.speed.quick = $(sort $(filter-out %-slow %-thorough %-optional, $1))
.speed.slow = $(sort $(filter-out %-thorough, $1))
.speed.thorough = $(sort $1)

TIMEOUT_MULTIPLIER ?= 1
.mtestargs = --no-rebuild -t $(TIMEOUT_MULTIPLIER)
ifneq ($(SPEED), quick)
.mtestargs += --setup $(SPEED)
endif
.mtestargs += $(subst -j,--num-processes , $(filter-out -j, $(lastword -j1 $(filter -j%, $(MAKEFLAGS)))))

.check.mtestargs = $(MTESTARGS) $(.mtestargs) $(if $(V),--verbose,--print-errorlogs) \
    $(foreach s, $(sort $(.check.mtest-suites)), --suite $s)
.bench.mtestargs = $(MTESTARGS) $(.mtestargs) --benchmark --verbose \
    $(foreach s, $(sort $(.bench.mtest-suites)), --suite $s)

all-check-targets = check-block check-block-luks check-block-nbd check-block-parallels check-block-qcow2 check-block-qed check-block-raw check-block-slow check-block-thorough check-block-vdi check-block-vhdx check-block-vmdk check-block-vpc check-decodetree check-func check-func-quick check-func-thorough check-func-x86_64 check-func-x86_64-thorough check-qapi-frontend check-qapi-interop check-qapi-schema check-qga check-qtest check-qtest-x86_64 check-softfloat check-softfloat-compare check-softfloat-conv check-softfloat-ops check-softfloat-ops-slow check-softfloat-slow check-tcg check-tcg-x86_64-softmmu check-tracetool check-unit
all-check-xml = check-report-block.junit.xml check-report-block-luks.junit.xml check-report-block-nbd.junit.xml check-report-block-parallels.junit.xml check-report-block-qcow2.junit.xml check-report-block-qed.junit.xml check-report-block-raw.junit.xml check-report-block-slow.junit.xml check-report-block-thorough.junit.xml check-report-block-vdi.junit.xml check-report-block-vhdx.junit.xml check-report-block-vmdk.junit.xml check-report-block-vpc.junit.xml check-report-decodetree.junit.xml check-report-func.junit.xml check-report-func-quick.junit.xml check-report-func-thorough.junit.xml check-report-func-x86_64.junit.xml check-report-func-x86_64-thorough.junit.xml check-report-qapi-frontend.junit.xml check-report-qapi-interop.junit.xml check-report-qapi-schema.junit.xml check-report-qga.junit.xml check-report-qtest.junit.xml check-report-qtest-x86_64.junit.xml check-report-softfloat.junit.xml check-report-softfloat-compare.junit.xml check-report-softfloat-conv.junit.xml check-report-softfloat-ops.junit.xml check-report-softfloat-ops-slow.junit.xml check-report-softfloat-slow.junit.xml check-report-tcg.junit.xml check-report-tcg-x86_64-softmmu.junit.xml check-report-tracetool.junit.xml check-report-unit.junit.xml
.PHONY: check do-meson-check check-report.junit.xml $(all-check-targets) $(all-check-xml)
ninja-cmd-goals += $(foreach s, $(.check.mtest-suites), $(.check-$s.deps))
check-build: run-ninja
check $(all-check-targets): do-meson-check
do-meson-check: run-ninja; $(if $(MAKE.n),,+)$(MESON) test $(.check.mtestargs)
check-report.junit.xml $(all-check-xml): check-report%.junit.xml: run-ninja
	$(MAKE) check$* MTESTARGS="$(MTESTARGS) --logbase check-report$*" && ln -f meson-logs/$@ .

.check-qtest.deps = pc-bios/edk2-aarch64-code.fd pc-bios/edk2-aarch64-vars.fd pc-bios/edk2-loongarch64-code.fd pc-bios/edk2-loongarch64-vars.fd pc-bios/edk2-riscv64-code.fd pc-bios/edk2-riscv64-vars.fd pc-bios/edk2-x86_64-code.fd pc-bios/edk2-x86_64-secure-code.fd qemu-img qemu-system-x86_64 storage-daemon/qemu-storage-daemon tests/qtest/ahci-test tests/qtest/am53c974-test tests/qtest/amd-iommu-test tests/qtest/bios-tables-test tests/qtest/boot-order-test tests/qtest/cdrom-test tests/qtest/cpu-plug-test tests/qtest/cxl-test tests/qtest/dbus-display-test tests/qtest/dbus-vmstate-test tests/qtest/device-introspect-test tests/qtest/device-plug-test tests/qtest/display-vga-test tests/qtest/drive_del-test tests/qtest/dump-test tests/qtest/e820-test tests/qtest/endianness-test tests/qtest/erst-test tests/qtest/fdc-test tests/qtest/fuzz-e1000e-test tests/qtest/fuzz-lsi53c895a-test tests/qtest/fuzz-megasas-test tests/qtest/fuzz-sb16-test tests/qtest/fuzz-sdcard-test tests/qtest/fuzz-virtio-scsi-test tests/qtest/fw_cfg-test tests/qtest/hd-geo-test tests/qtest/i440fx-test tests/qtest/i82801b11-test tests/qtest/ide-test tests/qtest/intel-hda-test tests/qtest/intel-iommu-test tests/qtest/ioh3420-test tests/qtest/iommu-intel-inv-test tests/qtest/iommu-intel-test tests/qtest/ipmi-bt-test tests/qtest/ipmi-kcs-test tests/qtest/ivshmem-test tests/qtest/lpc-ich9-test tests/qtest/machine-none-test tests/qtest/migration-test tests/qtest/netdev-socket tests/qtest/numa-test tests/qtest/pvpanic-pci-test tests/qtest/pvpanic-test tests/qtest/pxe-test tests/qtest/q35-test tests/qtest/qmp-cmd-test tests/qtest/qmp-test tests/qtest/qom-test tests/qtest/qos-test tests/qtest/readconfig-test tests/qtest/rtc-test tests/qtest/rtl8139-test tests/qtest/tco-test tests/qtest/test-filter-buffer tests/qtest/test-filter-mirror tests/qtest/test-filter-redirector tests/qtest/test-hmp tests/qtest/test-netfilter tests/qtest/test-x86-cpuid-compat tests/qtest/tpm-crb-swtpm-test tests/qtest/tpm-crb-test tests/qte